{
  "name": "adaptive-memory-multi-model-router",
  "version": "2.16.3",
  "description": "A3M Router: Parallel LLM routing gateway with ensemble voting — 14% faster than OpenRouter, 92% cheaper | 80+ providers | Fixed: main entry point, TypeScript 5.8, blessed types | npm: 6K+/mo | PyPI: 700+/mo",
  "main": "dist/index.js",
  "bin": {
    "a3m-router": "./dist/cli.js",
    "a3m": "./dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js serve",
    "test": "node --test",
    "test:vitest": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:watch": "npx vitest",
    "lint": "eslint src/",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/routing/jev/weights',{recursive:true});try{fs.copyFileSync('src/routing/jev/weights/jev-router-weights.json','dist/routing/jev/weights/jev-router-weights.json')}catch(e){}\"",
    "jev:distill": "node tools/distill.mjs",
    "jev:train": "python3 tools/train_jev.py && python3 tools/calibrate_temp.py"
  },
  "keywords": [
    "llm",
    "router",
    "gateway",
    "openai",
    "anthropic",
    "multi-provider",
    "cost-optimization",
    "langchain",
    "llamaindex",
    "agentkit",
    "a3m",
    "openrouter",
    "litellm",
    "proxy",
    "api-gateway",
    "artificial-intelligence",
    "machine-learning",
    "nlp",
    "transformers",
    "embeddings",
    "rag",
    "vector-search"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Das-rebel/a3m-router"
  },
  "homepage": "https://github.com/Das-rebel/a3m-router#readme",
  "dependencies": {
    "blessed": "^0.1.81",
    "nanoid": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Das-rebel"
  },
  "bugs": {
    "url": "https://github.com/Das-rebel/a3m-router/issues"
  },
  "pypi": "https://pypi.org/project/a3m-router/"
}
